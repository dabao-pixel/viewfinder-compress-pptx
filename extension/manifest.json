{
  "manifest_version": 3,
  "name": "Viewfinder Fitting",
  "version": "1.0.0",
  "description": "Bấm 1 nút trên web Viewfinder Fitting: tự gửi ảnh sang Gemini (tài khoản Google của bạn) và đưa ảnh kết quả về web.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://dabao-pixel.github.io/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dabao-pixel.github.io/viewfinder-compress-pptx/*"
      ],
      "js": [
        "web.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "Viewfinder Fitting"
  }
}